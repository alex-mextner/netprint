{
  "_comment": "Vendor (IEEE OUI) rules. A vendor alone is weak evidence: most brands make several kinds of devices, and many devices carry the MAC of their Wi-Fi MODULE maker (Espressif, AMPAK, Fn-link...), not of the brand on the box. Keep weights modest (<= 0.6) unless the vendor makes one kind of thing only.",
  "rules": [
    {"id": "oui.apple.laptop", "category": "laptop", "weight": 0.3, "when": {"vendor": "^Apple$"}, "note": "iPhones/Watches default to private addresses; a real Apple MAC is more often a Mac, iPad, Apple TV or HomePod"},
    {"id": "oui.apple.phone", "category": "phone", "weight": 0.25, "when": {"vendor": "^Apple$"}},
    {"id": "oui.apple.tablet", "category": "tablet", "weight": 0.15, "when": {"vendor": "^Apple$"}},
    {"id": "oui.apple.media", "category": "media-player", "weight": 0.15, "when": {"vendor": "^Apple$"}},
    {"id": "oui.apple.hint", "category": null, "when": {"vendor": "^Apple$"}, "label": "Apple device", "vendor": "Apple"},

    {"id": "oui.samsung.phone", "category": "phone", "weight": 0.4, "when": {"vendor": "^Samsung$"}},
