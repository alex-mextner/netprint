{
  "_comment": "Home Assistant device registry facts, passed in 'extra' by a collector that can read it: ha.domain (space-separated integration domains of the device's config entries), ha.model, ha.manufacturer, ha.title (config entry title), name (the user's name for it). The registry is curated by the user, so these weigh a lot.",
  "rules": [
    {"id": "ha.esphome", "category": "esp-diy", "weight": 0.9, "when": {"extra": {"ha.domain": "(^| )esphome( |$)"}}, "source": "ha_registry", "label": "ESPHome device", "detail": "Home Assistant: ESPHome integration"},
    {"id": "ha.esphome.ir", "category": "ir-remote", "weight": 0.96, "when": {"extra": {"ha.domain": "(^| )esphome( |$)", "name": "(^|\\W)(IR|ИК|пульт|remote|blaster)(\\W|$)"}}, "demote": ["esp-diy"], "source": "ha_registry", "label": "ESPHome IR remote", "detail": "Home Assistant: ESPHome device named \"{extra.name}\""},
    {"id": "ha.esphome.light", "category": "iot-light", "weight": 0.95, "when": {"extra": {"ha.domain": "(^| )esphome( |$)", "name": "light|lamp|led|strip|bulb|свет|лампа|люстра|подсветка"}}, "demote": ["esp-diy"], "source": "ha_registry", "label": "ESPHome light", "detail": "Home Assistant: ESPHome device named \"{extra.name}\""},
    {"id": "ha.esphome.climate", "category": "iot-sensor", "weight": 0.95, "when": {"extra": {"ha.domain": "(^| )esphome( |$)", "name": "(^|\\W)(AC|air ?con|climate|conditioner|кондиционер|кондей|климат|thermostat)(\\W|$)"}}, "demote": ["esp-diy"], "source": "ha_registry", "label": "ESPHome climate controller"},
    {"id": "ha.esphome.projector", "category": "ir-remote", "weight": 0.95, "when": {"extra": {"ha.domain": "(^| )esphome( |$)", "name": "projector|проектор"}}, "demote": ["esp-diy"], "source": "ha_registry", "label": "ESPHome projector controller"},
    {"id": "ha.yandex-station", "category": "speaker", "weight": 0.97, "when": {"extra": {"ha.domain": "yandex_station"}}, "source": "ha_registry", "label": "Yandex Station", "vendor": "Yandex", "icon": "mdi:speaker-message"},
    {"id": "ha.cast", "category": "media-player", "weight": 0.8, "when": {"extra": {"ha.domain": "(^| )cast( |$)"}}, "source": "ha_registry", "detail": "Home Assistant: Google Cast"},
    {"id": "ha.androidtv", "category": "media-player", "weight": 0.8, "when": {"extra": {"ha.domain": "androidtv(_remote)?"}}, "source": "ha_registry", "detail": "Home Assistant: Android TV"},
    {"id": "ha.appletv-roku", "category": "media-player", "weight": 0.95, "when": {"extra": {"ha.domain": "apple_tv|roku|firetv|nvidia_shield"}}, "source": "ha_registry"},
    {"id": "ha.tv", "category": "tv", "weight": 0.97, "when": {"extra": {"ha.domain": "samsungtv|webostv|braviatv|philips_js|vizio|panasonic_viera|hisense|lg_netcast|tcl"}}, "source": "ha_registry", "detail": "Home Assistant: TV integration ({extra.ha.domain})"},
    {"id": "ha.model.samsung-tv", "category": "tv", "weight": 0.95, "when": {"extra": {"ha.model": "^(?P<m>(UE|UN|QE|QN|GQ|GU|UA)\\d{2}[A-Z0-9]{3,})"}}, "source": "ha_registry", "label": "Samsung TV {m}", "vendor": "Samsung"},
    {"id": "ha.dlna-renderer", "category": "media-player", "weight": 0.3, "when": {"extra": {"ha.domain": "dlna_dmr"}}, "source": "ha_registry"},
    {"id": "ha.kodi", "category": "media-player", "weight": 0.5, "when": {"extra": {"ha.domain": "(^| )kodi( |$)"}}, "source": "ha_registry"},
    {"id": "ha.speakers", "category": "speaker", "weight": 0.95, "when": {"extra": {"ha.domain": "sonos|bluesound|heos|denonavr|yamaha_musiccast|linkplay|bose|soundtouch|squeezebox|slimproto|alexa_devices|google_assistant_sdk"}}, "source": "ha_registry"},
    {"id": "ha.3d-printer", "category": "3d-printer", "weight": 0.97, "when": {"extra": {"ha.domain": "moonraker|octoprint|ha_creality_ws|creality|bambu_lab|prusalink|elegoo|anycubic|duet"}}, "source": "ha_registry", "label": "{extra.ha.title}", "icon": "mdi:printer-3d-nozzle", "detail": "Home Assistant: {extra.ha.domain} integration ({extra.ha.title})"},
    {"id": "ha.printer", "category": "printer", "weight": 0.95, "when": {"extra": {"ha.domain": "(^| )(ipp|brother|epson|hp_printer)( |$)"}}, "source": "ha_registry"},
    {"id": "ha.camera", "category": "camera", "weight": 0.9, "when": {"extra": {"ha.domain": "onvif|reolink|hikvision|hikvisioncam|dahua|amcrest|ezviz|tapo_control|foscam|axis|unifiprotect|frigate|imou|yi_hack"}}, "source": "ha_registry"},
    {"id": "ha.nas", "category": "nas", "weight": 0.97, "when": {"extra": {"ha.domain": "synology_dsm|qnap|truenas|unraid"}}, "source": "ha_registry"},
    {"id": "ha.router", "category": "router", "weight": 0.7, "when": {"extra": {"ha.domain": "keenetic_ndms2|asuswrt|fritz|netgear|openwrt|luci|mikrotik|miwifi|tplink_router|ubus"}}, "source": "ha_registry"},
    {"id": "ha.tuya", "category": "iot-plug", "weight": 0.6, "when": {"extra": {"ha.domain": "(^| )(tuya|xtend_tuya|localtuya)( |$)"}}, "source": "ha_registry", "vendor": "Tuya"},
    {"id": "ha.plug-makers", "category": "iot-plug", "weight": 0.9, "when": {"extra": {"ha.domain": "shelly|tasmota|tplink|kasa|sonoff|wemo|meross|switchbot"}}, "source": "ha_registry"},
    {"id": "ha.light-makers", "category": "iot-light", "weight": 0.95, "when": {"extra": {"ha.domain": "(^| )(wled|hue|yeelight|lifx|nanoleaf|govee_light_local|wiz|elgato|twinkly)( |$)"}}, "source": "ha_registry"},
    {"id": "ha.ir", "category": "ir-remote", "weight": 0.9, "when": {"extra": {"ha.domain": "broadlink|harmony|remote_rpc"}}, "source": "ha_registry"},
    {"id": "ha.xiaomi-miio", "category": "iot-sensor", "weight": 0.7, "when": {"extra": {"ha.domain": "xiaomi_miio|xiaomi_home|roborock|dreame|ecovacs"}}, "source": "ha_registry"},
    {"id": "ha.climate", "category": "iot-sensor", "weight": 0.85, "when": {"extra": {"ha.domain": "daikin|gree|midea_ac|tado|ecobee|nest|sensibo|mitsubishi|toshiba_ac|smartthinq_sensors"}}, "source": "ha_registry"},
    {"id": "ha.model.light", "category": "iot-light", "weight": 0.85, "when": {"extra": {"ha.model": "light|lamp|bulb|strip|ceiling|LED"}}, "source": "ha_registry", "detail": "Home Assistant model \"{extra.ha.model}\""},
    {"id": "ha.model.plug", "category": "iot-plug", "weight": 0.85, "when": {"extra": {"ha.model": "plug|socket|outlet|relay|breaker|power strip|розетка"}}, "source": "ha_registry", "detail": "Home Assistant model \"{extra.ha.model}\""},
    {"id": "ha.model.ir", "category": "ir-remote", "weight": 0.85, "when": {"extra": {"ha.model": "(^|\\W)IR(\\W|$)|remote|blaster|пульт"}}, "source": "ha_registry", "detail": "Home Assistant model \"{extra.ha.model}\""},
    {"id": "ha.model.sensor", "category": "iot-sensor", "weight": 0.8, "when": {"extra": {"ha.model": "sensor|thermo|humid|purifier|vacuum|air ?conditioner|heater|kettle|датчик"}}, "source": "ha_registry", "detail": "Home Assistant model \"{extra.ha.model}\""},
    {"id": "ha.model.chromecast", "category": "media-player", "weight": 0.95, "when": {"extra": {"ha.model": "Chromecast(?! Audio)|Google TV|Mi Box|SHIELD|Fire TV"}}, "source": "ha_registry", "label": "{extra.ha.model}"},
    {"id": "ha.model.apple", "category": "phone", "weight": 0.97, "when": {"extra": {"ha.model": "^iPhone"}}, "source": "ha_registry", "label": "iPhone", "vendor": "Apple"},
    {"id": "ha.model.ipad", "category": "tablet", "weight": 0.97, "when": {"extra": {"ha.model": "^iPad"}}, "source": "ha_registry", "label": "iPad", "vendor": "Apple"},
    {"id": "ha.model.mac", "category": "laptop", "weight": 0.8, "when": {"extra": {"ha.model": "^(MacBook|Mac1\\d,)"}}, "source": "ha_registry", "vendor": "Apple"},
    {"id": "ha.mobile-app", "category": "phone", "weight": 0.85, "when": {"extra": {"ha.domain": "mobile_app"}}, "source": "ha_registry"},
    {"id": "ha.model.hint", "category": null, "weight": 0.5, "when": {"extra": {"ha.manufacturer": "(?P<mf>.+)", "ha.model": "(?P<mo>.+)"}}, "label": "{mf} {mo}", "source": "ha_registry"}
  ]
}
