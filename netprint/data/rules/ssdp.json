{
  "_comment": "SSDP / UPnP rules. Fields: server, st, usn, location (from the M-SEARCH answer) and friendly_name, manufacturer, model_name, model_number, model_description, device_type (from the device description XML). All fields in one rule are checked on the SAME device.",
  "rules": [
    {"id": "ssdp.igd", "category": "router", "weight": 0.8, "when": {"ssdp": {"st": "InternetGatewayDevice|WANIPConnection|WANPPPConnection|WANCommonInterfaceConfig"}}, "detail": "UPnP Internet Gateway Device"},
    {"id": "ssdp.igd.type", "category": "router", "weight": 0.8, "when": {"ssdp": {"device_type": "InternetGatewayDevice"}}},
    {"id": "ssdp.wlan-ap", "category": "access-point", "weight": 0.6, "when": {"ssdp": {"device_type": "WLANAccessPointDevice"}}},
    {"id": "ssdp.xiaomi-router", "category": "access-point", "weight": 0.6, "when": {"ssdp": {"manufacturer": "Xiaomi", "model_name": "(?i)(router|mesh|AX\\d{4}|RD\\d\\d|RA\\d\\d|RB\\d\\d|RC\\d\\d|CR\\d{4}|Redmi)"}}, "vendor": "Xiaomi"},

    {"id": "ssdp.samsung-tv", "category": "tv", "weight": 0.95, "when": {"ssdp": {"model_name": "^(?P<m>(UE|UN|QE|QN|GQ|GU|UA|KU|KS|HG|LH|LS)\\d{2}[A-Z0-9]{3,})"}}, "label": "Samsung TV {m}", "vendor": "Samsung", "detail": "Samsung TV model {m}"},
    {"id": "ssdp.samsung-tv.friendly", "category": "tv", "weight": 0.9, "when": {"ssdp": {"friendly_name": "^\\[TV\\]"}}, "label": "Samsung TV", "vendor": "Samsung", "detail": "UPnP name {ssdp.friendly_name}"},
    {"id": "ssdp.samsung-server", "category": "tv", "weight": 0.7, "when": {"ssdp": {"server": "Samsung UPnP SDK|SHP, UPnP|Samsung AllShare|Samsung-Linux"}}, "vendor": "Samsung"},
    {"id": "ssdp.samsung-rc", "category": "tv", "weight": 0.85, "when": {"ssdp": {"st": "samsung\\.com:(device|service):(RemoteControlReceiver|MainTVServer2|MultiScreenService)|dial-multiscreen-org:device:dialreceiver"}}, "vendor": "Samsung"},
    {"id": "ssdp.lg-tv", "category": "tv", "weight": 0.9, "when": {"ssdp": {"server": "WebOS|webOS|LGE WebOS"}}, "label": "LG webOS TV", "vendor": "LG"},
    {"id": "ssdp.lg-tv.manufacturer", "category": "tv", "weight": 0.85, "when": {"ssdp": {"manufacturer": "LG Electronics", "device_type": "MediaRenderer|tvdevice|dial"}}, "vendor": "LG"},
    {"id": "ssdp.sony-tv", "category": "tv", "weight": 0.85, "when": {"ssdp": {"manufacturer": "^Sony", "model_name": "(?P<m>(KD|KDL|XR|FW|KJ)-\\d{2}[A-Z0-9]+)"}}, "label": "Sony TV {m}", "vendor": "Sony"},
    {"id": "ssdp.tv-generic", "category": "tv", "weight": 0.6, "when": {"ssdp": {"model_description": "(?i)\\b(TV|television|Smart TV)\\b"}}},
    {"id": "ssdp.tv-maker-renderer", "category": "tv", "weight": 0.7, "when": {"ssdp": {"manufacturer": "(?i)Hisense|TCL|Philips|TP Vision|Panasonic|Sharp|Toshiba|Vestel|Xiaomi TV|KIVI|Thomson|Haier|Skyworth", "device_type": "MediaRenderer"}}},
    {"id": "ssdp.roku", "category": "media-player", "weight": 0.95, "when": {"ssdp": {"st": "roku:ecp"}}, "label": "Roku", "vendor": "Roku"},
    {"id": "ssdp.chromecast", "category": "media-player", "weight": 0.7, "when": {"ssdp": {"manufacturer": "^Google", "model_name": "(?i)Eureka|Chromecast"}}, "label": "Chromecast", "vendor": "Google"},
    {"id": "ssdp.dial", "category": "media-player", "weight": 0.3, "when": {"ssdp": {"st": "dial-multiscreen-org:service:dial"}}, "detail": "DIAL (second-screen) receiver"},
    {"id": "ssdp.dial.tv", "category": "tv", "weight": 0.3, "when": {"ssdp": {"st": "dial-multiscreen-org:service:dial"}}},
    {"id": "ssdp.renderer", "category": "media-player", "weight": 0.3, "when": {"ssdp": {"device_type": "MediaRenderer"}}, "detail": "UPnP MediaRenderer"},
    {"id": "ssdp.renderer.tv", "category": "tv", "weight": 0.2, "when": {"ssdp": {"device_type": "MediaRenderer"}}},
    {"id": "ssdp.renderer.speaker", "category": "speaker", "weight": 0.15, "when": {"ssdp": {"device_type": "MediaRenderer"}}},
    {"id": "ssdp.media-server", "category": "nas", "weight": 0.2, "when": {"ssdp": {"device_type": "MediaServer"}}, "detail": "UPnP MediaServer (DLNA library)"},
    {"id": "ssdp.media-server.server", "category": "server", "weight": 0.25, "when": {"ssdp": {"device_type": "MediaServer"}}},
    {"id": "ssdp.kodi", "category": "media-player", "weight": 0.5, "when": {"ssdp": {"model_name": "^Kodi$"}}, "label": "Kodi"},
    {"id": "ssdp.plex", "category": "server", "weight": 0.5, "when": {"ssdp": {"model_name": "Plex Media Server"}}},
    {"id": "ssdp.jellyfin-minidlna", "category": "server", "weight": 0.4, "when": {"ssdp": {"model_name": "Jellyfin|Emby|MiniDLNA|ReadyMedia|Gerbera|Universal Media Server|Serviio"}}},
    {"id": "ssdp.synology", "category": "nas", "weight": 0.9, "when": {"ssdp": {"manufacturer": "Synology"}}, "label": "Synology NAS", "vendor": "Synology"},
    {"id": "ssdp.qnap", "category": "nas", "weight": 0.9, "when": {"ssdp": {"manufacturer": "QNAP"}}, "label": "QNAP NAS", "vendor": "QNAP"},
    {"id": "ssdp.sonos", "category": "speaker", "weight": 0.95, "when": {"ssdp": {"device_type": "ZonePlayer"}}, "label": "Sonos", "vendor": "Sonos"},
    {"id": "ssdp.sonos.server", "category": "speaker", "weight": 0.9, "when": {"ssdp": {"server": "Sonos"}}, "vendor": "Sonos"},
    {"id": "ssdp.hue", "category": "iot-light", "weight": 0.9, "when": {"ssdp": {"model_name": "Philips hue bridge"}}, "label": "Philips Hue bridge", "icon": "mdi:hub"},
    {"id": "ssdp.hue.server", "category": "iot-light", "weight": 0.8, "when": {"ssdp": {"server": "IpBridge"}}, "label": "Philips Hue bridge", "icon": "mdi:hub"},
    {"id": "ssdp.wemo", "category": "iot-plug", "weight": 0.9, "when": {"ssdp": {"device_type": "Belkin:device:(controllee|insight|lightswitch)"}}, "label": "Wemo", "vendor": "Belkin"},
    {"id": "ssdp.printer", "category": "printer", "weight": 0.85, "when": {"ssdp": {"device_type": "device:Printer|device:Basic.*printer"}}},
    {"id": "ssdp.printer-maker", "category": "printer", "weight": 0.6, "when": {"ssdp": {"manufacturer": "^(Brother|EPSON|Seiko Epson|Canon|HP|Hewlett|Kyocera|Xerox|Ricoh|Lexmark)"}}},
    {"id": "ssdp.camera", "category": "camera", "weight": 0.7, "when": {"ssdp": {"device_type": "(?i)NetworkCamera|DigitalSecurityCamera|IPC"}}},
    {"id": "ssdp.camera-maker", "category": "camera", "weight": 0.7, "when": {"ssdp": {"manufacturer": "(?i)Hikvision|Dahua|Reolink|Axis|Amcrest|Foscam|Uniview"}}},
    {"id": "ssdp.windows", "category": "desktop", "weight": 0.35, "when": {"ssdp": {"server": "Microsoft-Windows|Windows NT|Windows/"}}, "detail": "Windows SSDP stack"},
    {"id": "ssdp.windows.laptop", "category": "laptop", "weight": 0.3, "when": {"ssdp": {"server": "Microsoft-Windows|Windows NT|Windows/"}}},
    {"id": "ssdp.xbox", "category": "game-console", "weight": 0.9, "when": {"ssdp": {"model_name": "Xbox"}}, "label": "Xbox", "vendor": "Microsoft"},
    {"id": "ssdp.playstation", "category": "game-console", "weight": 0.9, "when": {"ssdp": {"model_name": "PlayStation|PS[345]"}}, "label": "PlayStation", "vendor": "Sony"},
    {"id": "ssdp.yandex", "category": "speaker", "weight": 0.85, "when": {"ssdp": {"manufacturer": "Yandex"}}, "label": "Yandex Station", "vendor": "Yandex"},
    {"id": "ssdp.model-hint", "category": null, "weight": 0.6, "when": {"ssdp": {"manufacturer": "(?P<mf>.+)", "model_name": "(?P<mn>.+)"}}, "label": "{mf} {mn}", "vendor": "{mf}", "product": "{mn}", "model": "{mn}", "detail": "UPnP {mf} {mn}"},
    {"id": "ssdp.manufacturer-hint", "category": null, "weight": 0.55, "when": {"ssdp": {"manufacturer": "(?P<mf>.+)"}}, "vendor": "{mf}"},
    {"id": "ssdp.model-number", "category": null, "weight": 0.55, "when": {"ssdp": {"model_number": "(?P<n>.+)"}}, "model_id": "{n}"},
    {"id": "ssdp.samsung-tv.decode", "category": null, "weight": 0.96, "when": {"ssdp": {"model_name": "^(?P<m>(UE|UN|UA|GU|HG)(?P<s>\\d{2})(?P<y>[A-Z]{1,2}?)(?P<n>\\d{4,5})[A-Z0-9]*)$"}, "lookup": {"table": "samsung_tv", "key": "{y}"}}, "vendor": "Samsung", "product": "TV {s}″ {y}{n}", "model": "{m} ({lookup.year})", "model_id": "{m}"},
    {"id": "ssdp.os.android", "category": null, "weight": 0.5, "when": {"ssdp": {"server": "android(?P<v>\\d+)"}}, "os": "Android {v}"},
    {"id": "ssdp.os.windows", "category": null, "weight": 0.5, "when": {"ssdp": {"server": "Microsoft-Windows|Windows NT|Windows/"}}, "os": "Windows"},
    {"id": "ssdp.os.webos", "category": null, "weight": 0.5, "when": {"ssdp": {"server": "web ?OS"}}, "os": "webOS"},
    {"id": "ssdp.os.tizen", "category": null, "weight": 0.5, "when": {"ssdp": {"server": "Tizen"}}, "os": "Tizen"}
  ]
}
