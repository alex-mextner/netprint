{
  "_comment": "mDNS / DNS-SD rules. mdns_service, mdns_name and mdns_txt in one rule are checked against the SAME service instance. Service types are written without the '.local' suffix, e.g. '_airplay._tcp'. TXT keys are matched case-insensitively. Apple model identifiers (TXT model= of _device-info, rpMd= of _companion-link, model= of _airplay/_raop) are the strongest evidence there is.",
  "rules": [
    {"id": "mdns.apple-model.iphone", "category": "phone", "weight": 0.98, "when": {"mdns_txt": {"model": "^(?P<m>iPhone\\d+,\\d+)"}}, "label": "iPhone", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-rpmd.iphone", "category": "phone", "weight": 0.98, "when": {"mdns_txt": {"rpMd": "^(?P<m>iPhone\\d+,\\d+)"}}, "label": "iPhone", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.ipad", "category": "tablet", "weight": 0.98, "when": {"mdns_txt": {"model": "^(?P<m>iPad\\d+,\\d+)"}}, "label": "iPad", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-rpmd.ipad", "category": "tablet", "weight": 0.98, "when": {"mdns_txt": {"rpMd": "^(?P<m>iPad\\d+,\\d+)"}}, "label": "iPad", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.watch", "category": "watch", "weight": 0.98, "when": {"mdns_txt": {"model": "^(?P<m>Watch\\d+,\\d+)"}}, "label": "Apple Watch", "vendor": "Apple", "icon": "mdi:watch-variant", "detail": "Apple model {m}"},
    {"id": "mdns.apple-rpmd.watch", "category": "watch", "weight": 0.98, "when": {"mdns_txt": {"rpMd": "^(?P<m>Watch\\d+,\\d+)"}}, "label": "Apple Watch", "vendor": "Apple", "icon": "mdi:watch-variant", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.macbook", "category": "laptop", "weight": 0.98, "when": {"mdns_txt": {"model": "^(?P<m>MacBook(Pro|Air)?\\d+,\\d+)"}}, "label": "MacBook", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-rpmd.macbook", "category": "laptop", "weight": 0.98, "when": {"mdns_txt": {"rpMd": "^(?P<m>MacBook(Pro|Air)?\\d+,\\d+)"}}, "label": "MacBook", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.mac-desktop", "category": "desktop", "weight": 0.97, "when": {"mdns_txt": {"model": "^(?P<m>(iMac|iMacPro|Macmini|MacPro)\\d+,\\d+)"}}, "label": "Mac", "vendor": "Apple", "icon": "mdi:desktop-classic", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.mac-laptop-exact", "category": "laptop", "weight": 0.97, "when": {"mdns_txt": {"model": "^(?P<m>Mac14,(2|5|6|7|9|10|15)|Mac15,(3|6|7|8|9|10|11|12|13)|Mac16,(1|5|6|7|8|12|13))$"}}, "demote": ["desktop"], "label": "MacBook", "vendor": "Apple", "detail": "Apple model {m} (a MacBook)"},
    {"id": "mdns.apple-model.mac-desktop-exact", "category": "desktop", "weight": 0.97, "when": {"mdns_txt": {"model": "^(?P<m>Mac13,(1|2)|Mac14,(3|8|12|13|14)|Mac15,(4|5|14)|Mac16,(2|3|9|10|11))$"}}, "demote": ["laptop"], "label": "Mac", "vendor": "Apple", "icon": "mdi:desktop-classic", "detail": "Apple model {m} (iMac / Mac mini / Studio / Pro)"},
    {"id": "mdns.apple-rpmd.mac", "category": "laptop", "weight": 0.5, "when": {"mdns_txt": {"rpMd": "^(?P<m>Mac\\d+,\\d+)"}}, "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.mac-new", "category": "laptop", "weight": 0.6, "when": {"mdns_txt": {"model": "^(?P<m>Mac1[4-9],\\d+)"}}, "label": "Mac", "vendor": "Apple", "detail": "Apple model {m} (Apple-silicon Macs share the MacNN,N scheme)"},
    {"id": "mdns.apple-model.mac-new.desktop", "category": "desktop", "weight": 0.4, "when": {"mdns_txt": {"model": "^Mac1[4-9],\\d+"}}},
    {"id": "mdns.apple-model.appletv", "category": "media-player", "weight": 0.98, "when": {"mdns_txt": {"model": "^(?P<m>AppleTV\\d+,\\d+)"}}, "label": "Apple TV", "vendor": "Apple", "icon": "mdi:apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-rpmd.appletv", "category": "media-player", "weight": 0.98, "when": {"mdns_txt": {"rpMd": "^(?P<m>AppleTV\\d+,\\d+)"}}, "label": "Apple TV", "vendor": "Apple", "icon": "mdi:apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.homepod", "category": "speaker", "weight": 0.98, "when": {"mdns_txt": {"model": "^(?P<m>AudioAccessory\\d+,\\d+)"}}, "label": "HomePod", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-rpmd.homepod", "category": "speaker", "weight": 0.98, "when": {"mdns_txt": {"rpMd": "^(?P<m>AudioAccessory\\d+,\\d+)"}}, "label": "HomePod", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.airport", "category": "router", "weight": 0.9, "when": {"mdns_txt": {"model": "^(?P<m>AirPort\\d+,\\d+|TimeCapsule\\d+,\\d+)"}}, "label": "AirPort", "vendor": "Apple", "detail": "Apple model {m}"},
    {"id": "mdns.apple-model.hint", "category": null, "when": {"mdns_service": "^_device-info\\._tcp$", "mdns_txt": {"model": "(?P<m>.+)"}}, "label": "{m}"},

