{
  "_comment": "Hostname rules: DHCP option 12, mDNS host names, reverse DNS, router-reported and NetBIOS names. Vendors' default names are strong evidence; user-chosen words ('tv', 'lamp') weaker. Patterns are case-insensitive re.search.",
  "rules": [
    {"id": "host.iphone", "category": "phone", "weight": 0.85, "when": {"hostname": "iphone"}, "unless": {"hostname": "iphone-?(charger|dock)"}, "label": "iPhone", "vendor": "Apple", "icon": "mdi:cellphone"},
    {"id": "host.ipad", "category": "tablet", "weight": 0.85, "when": {"hostname": "ipad"}, "label": "iPad", "vendor": "Apple"},
    {"id": "host.apple-watch", "category": "watch", "weight": 0.85, "when": {"hostname": "apple-?watch"}, "label": "Apple Watch", "vendor": "Apple", "icon": "mdi:watch-variant"},
    {"id": "host.macbook", "category": "laptop", "weight": 0.85, "when": {"hostname": "macbook|(^|[-_ ])(mbp|mba)([-_ ]|\\d|$)"}, "label": "MacBook", "vendor": "Apple", "icon": "mdi:laptop"},
    {"id": "host.imac", "category": "desktop", "weight": 0.8, "when": {"hostname": "(^|[^a-z])imac|mac-?mini|mac-?studio|mac-?pro(?!.*book)"}, "label": "Mac", "vendor": "Apple", "icon": "mdi:desktop-classic"},
    {"id": "host.appletv", "category": "media-player", "weight": 0.85, "when": {"hostname": "apple-?tv"}, "label": "Apple TV", "vendor": "Apple", "icon": "mdi:apple"},
    {"id": "host.homepod", "category": "speaker", "weight": 0.85, "when": {"hostname": "homepod"}, "label": "HomePod", "vendor": "Apple"},

    {"id": "host.android-default", "category": "phone", "weight": 0.6, "when": {"hostname": "^android[-_]?[0-9a-f]{8,}"}, "label": "Android device", "detail": "Android's default DHCP name"},
    {"id": "host.android-default.tablet", "category": "tablet", "weight": 0.15, "when": {"hostname": "^android[-_]?[0-9a-f]{8,}"}},
    {"id": "host.android-word", "category": "phone", "weight": 0.55, "when": {"hostname": "android"}, "unless": {"hostname": "android-?tv|^android[-_]?[0-9a-f]{8,}"}},
    {"id": "host.galaxy-phone", "category": "phone", "weight": 0.8, "when": {"hostname": "galaxy|^sm-[aefgmnsz]\\d|samsung-?(s|a|note|z)\\d"}, "unless": {"hostname": "galaxy-?(tab|watch|book|buds)|^sm-[tpxr]\\d"}, "label": "Samsung Galaxy", "vendor": "Samsung"},
    {"id": "host.galaxy-tab", "category": "tablet", "weight": 0.85, "when": {"hostname": "galaxy-?tab|^sm-[tpx]\\d"}, "label": "Galaxy Tab", "vendor": "Samsung"},
    {"id": "host.galaxy-watch", "category": "watch", "weight": 0.85, "when": {"hostname": "galaxy-?watch|^sm-r\\d"}, "label": "Galaxy Watch", "vendor": "Samsung"},
    {"id": "host.galaxy-book", "category": "laptop", "weight": 0.8, "when": {"hostname": "galaxy-?book"}, "label": "Galaxy Book", "vendor": "Samsung"},
    {"id": "host.phone-brands", "category": "phone", "weight": 0.75, "when": {"hostname": "(^|[-_ ])(pixel|redmi|poco|xiaomi-?1\\d|mi-?\\d{1,2}|oneplus|huawei|honor|oppo|vivo|realme|nokia|moto-?[egz]|motorola|nothing-?phone|fairphone|xperia)"}, "unless": {"hostname": "redmi-?(book|router|pad)|mi-?(box|tv|router|pad)|pixel-?(book|tablet|watch|buds)|huawei-?(matebook|router)|honor-?(pad|magicbook)|xiaomi-?(router|pad|tv)"}},
    {"id": "host.phone-word", "category": "phone", "weight": 0.6, "when": {"hostname": "(^|[-_ ])(phone|mobile|smartphone|телефон|айфон|смартфон)"}},
    {"id": "host.tablet-word", "category": "tablet", "weight": 0.6, "when": {"hostname": "(^|[-_ ])(tablet|tab-?[as]\\d|mipad|redmi-?pad|xiaomi-?pad|mediapad|matepad|lenovo-?tab|kindle|планшет)"}},
    {"id": "host.watch-word", "category": "watch", "weight": 0.55, "when": {"hostname": "(^|[-_ ])(watch|часы)"}, "unless": {"hostname": "watchdog|watchtower"}},

    {"id": "host.windows-laptop", "category": "laptop", "weight": 0.8, "when": {"hostname": "^laptop-[a-z0-9]{6,8}$"}, "label": "Windows laptop", "detail": "Windows' default name for a laptop (LAPTOP-XXXXXXX)"},
    {"id": "host.windows-desktop", "category": "desktop", "weight": 0.55, "when": {"hostname": "^desktop-[a-z0-9]{6,8}$"}, "label": "Windows PC", "detail": "Windows' default name (DESKTOP-XXXXXXX): a PC, sometimes a laptop"},
    {"id": "host.windows-desktop.laptop", "category": "laptop", "weight": 0.35, "when": {"hostname": "^desktop-[a-z0-9]{6,8}$"}},
    {"id": "host.thinkpad", "category": "laptop", "weight": 0.85, "when": {"hostname": "thinkpad|^t\\d{3}s?[-_]|^x1[-_ ]?(carbon|yoga)|^[tpxel]\\d{2,3}[a-z]?-(gen\\d)?"}, "label": "ThinkPad", "vendor": "Lenovo"},
    {"id": "host.laptop-brands", "category": "laptop", "weight": 0.75, "when": {"hostname": "laptop|notebook|ноутбук|ideapad|yoga|zenbook|vivobook|xps-?1[357]|latitude|inspiron|elitebook|probook|spectre|envy-?x360|surface-?(laptop|book|pro)|chromebook|matebook|magicbook|redmibook|framework|legion|rog-?(strix|zephyrus)|tuf-|predator|aspire|swift|travelmate"}},
    {"id": "host.desktop-word", "category": "desktop", "weight": 0.6, "when": {"hostname": "desktop|workstation|(^|[-_])pc$|^pc[-_]|gaming-?pc|компьютер|комп$|tower"}, "unless": {"hostname": "^desktop-[a-z0-9]{6,8}$"}},
    {"id": "host.linux-default", "category": "desktop", "weight": 0.3, "when": {"hostname": "^(ubuntu|debian|fedora|arch|manjaro|mint|pop-os|linux)(-|$)"}},
    {"id": "host.linux-default.server", "category": "server", "weight": 0.3, "when": {"hostname": "^(ubuntu|debian|fedora|arch|centos|rocky|alma|linux)(-|$)"}},

    {"id": "host.esp", "category": "esp-diy", "weight": 0.8, "when": {"hostname": "^(esp[-_]?\\d*|esp32|esp8266|espressif|esphome|esp-?home|nodemcu|wemos|d1-?mini)([-_]|$)"}, "label": "ESP device"},
    {"id": "host.esp-default", "category": "esp-diy", "weight": 0.5, "when": {"hostname": "^ESP_[0-9A-F]{6}$"}, "detail": "ESP8266/ESP32 SDK default name (also Tuya/commercial)"},
    {"id": "host.esp-default.plug", "category": "iot-plug", "weight": 0.35, "when": {"hostname": "^ESP_[0-9A-F]{6}$"}},
    {"id": "host.tasmota", "category": "iot-plug", "weight": 0.75, "when": {"hostname": "tasmota"}, "label": "Tasmota device"},
    {"id": "host.shelly", "category": "iot-plug", "weight": 0.85, "when": {"hostname": "^shelly"}, "label": "Shelly", "vendor": "Shelly"},
    {"id": "host.sonoff", "category": "iot-plug", "weight": 0.8, "when": {"hostname": "sonoff|^itead"}, "label": "Sonoff", "vendor": "Sonoff"},
    {"id": "host.wled", "category": "iot-light", "weight": 0.85, "when": {"hostname": "^wled"}, "label": "WLED", "icon": "mdi:led-strip-variant"},
    {"id": "host.light-word", "category": "iot-light", "weight": 0.55, "when": {"hostname": "(^|[-_ ])(light|lamp|bulb|led|strip|hue|yeelight|lifx|nanoleaf|govee|свет|лампа|люстра|подсветка|ночник)"}, "unless": {"hostname": "flight|delight|lighthouse"}},
    {"id": "host.plug-word", "category": "iot-plug", "weight": 0.55, "when": {"hostname": "(^|[-_ ])(plug|socket|outlet|relay|power-?strip|розетка|реле|удлинитель)"}},
    {"id": "host.ir-word", "category": "ir-remote", "weight": 0.7, "when": {"hostname": "(^|[-_ ])(ir|irblaster|ir-?remote|remote|пульт|broadlink|rm-?(mini|pro|4))([-_ ]|\\d|$)"}, "label": "IR remote"},
    {"id": "host.climate-word", "category": "iot-sensor", "weight": 0.5, "when": {"hostname": "(^|[-_ ])(ac|aircon|climate|conditioner|hvac|thermostat|кондиционер|кондей|климат|термостат|humidifier|purifier|увлажнитель|очиститель)([-_ ]|\\d|$)"}},
    {"id": "host.sensor-word", "category": "iot-sensor", "weight": 0.5, "when": {"hostname": "(^|[-_ ])(sensor|датчик|temp|weather|meteo|co2|pm25|air-?quality|leak|motion|door|window|vacuum|roborock|dreame|roomba|пылесос)"}},
    {"id": "host.xiaomi-miio", "category": "iot-sensor", "weight": 0.7, "when": {"hostname": "^(zhimi|chuangmi|lumi|roborock|dreame|viomi|dmaker|cuco|yeelink|isa|mijia|xiaomi)[-.]"}, "label": "Xiaomi smart device", "vendor": "Xiaomi", "detail": "Xiaomi miIO model-style hostname"},
    {"id": "host.xiaomi-miio.light", "category": "iot-light", "weight": 0.8, "when": {"hostname": "^yeelink[-.]light"}, "demote": ["iot-sensor"], "label": "Yeelight", "vendor": "Xiaomi"},
    {"id": "host.xiaomi-miio.plug", "category": "iot-plug", "weight": 0.8, "when": {"hostname": "^(chuangmi|cuco|lumi)[-.]plug"}, "demote": ["iot-sensor"], "label": "Xiaomi plug", "vendor": "Xiaomi"},
    {"id": "host.xiaomi-miio.camera", "category": "camera", "weight": 0.8, "when": {"hostname": "^(chuangmi|isa|mijia)[-.]camera"}, "demote": ["iot-sensor"], "label": "Xiaomi camera", "vendor": "Xiaomi"},

    {"id": "host.yandex", "category": "speaker", "weight": 0.8, "when": {"hostname": "yandex|^yndx|station|алиса|alice|станция"}, "unless": {"hostname": "workstation|station-?(pc|wagon)|playstation|docking-?station"}, "label": "Yandex Station", "vendor": "Yandex", "icon": "mdi:speaker-message"},
    {"id": "host.speakers", "category": "speaker", "weight": 0.75, "when": {"hostname": "sonos|echo-?(dot|show|studio|pop)?(-|$)|^amazon-[0-9a-f]{6,}|alexa|nest-?(mini|audio|hub)|google-?home|homepod|speaker|soundbar|колонка|marusia|маруся|sber-?boom|sberboom"}},
    {"id": "host.tv-word", "category": "tv", "weight": 0.7, "when": {"hostname": "(^|[-_ \\[])(tv|television|телевизор|телик)([-_ \\]]|\\d|$)|bravia|webos|lgwebostv|tizen|samsung-?tv|^\\[tv\\]|smart-?tv|android-?tv|google-?tv|hisense|philips-?tv|tcl-?tv|xiaomi-?tv|mi-?tv"}},
    {"id": "host.media-players", "category": "media-player", "weight": 0.8, "when": {"hostname": "chromecast|fire-?tv|firestick|aft[a-z]{1,4}$|shield|roku|mi-?box|mibox|mi-?stick|tv-?box|tvbox|x96|h96|tanix|ugoos|zidoo|dune-?hd|nvidia|apple-?tv|kodi|libreelec|coreelec|osmc|plex-?player|infuse"}},
    {"id": "host.consoles", "category": "game-console", "weight": 0.8, "when": {"hostname": "xbox|playstation|^ps[345](-|$)|^ps-?vita|nintendo|^switch$|steam-?deck|steamdeck"}},
    {"id": "host.printer", "category": "printer", "weight": 0.8, "when": {"hostname": "printer|принтер|laserjet|officejet|deskjet|envy-?\\d|pixma|^brw[0-9a-f]{12}$|^brn[0-9a-f]{12}$|^npi[0-9a-f]{6}|^hp[0-9a-f]{6}$|^epson[0-9a-f]{6}$|^et-?\\d{4}|^mfc-|^dcp-|^hl-|^ecosys|^kyocera|^canon|^mf\\d{3}|^xerox|^ricoh|lexmark|^ipp-|^cups"}},
    {"id": "host.3dprinter", "category": "3d-printer", "weight": 0.85, "when": {"hostname": "octopi|octoprint|mainsail|fluidd|klipper|voron|ender-?\\d|prusa|bambu|x1c|p1[ps]|a1-?mini|snapmaker|creality|^k1(c|-?max|-?se)?([-_]|$)|^k2|anycubic|elegoo|flashforge|artillery|sovol|qidi|3d-?print|3dp"}, "icon": "mdi:printer-3d-nozzle"},
    {"id": "host.camera", "category": "camera", "weight": 0.7, "when": {"hostname": "(^|[-_])(cam|camera|ipcam|ip-?camera|cctv|nvr|dvr|doorbell|камера|видеонаблюдение|домофон)([-_]|\\d|$)|hikvision|reolink|dahua|ezviz|imou|tapo-?c\\d|wyze|eufy|blink"}},
    {"id": "host.raspberry-pi", "category": "raspberry-pi", "weight": 0.85, "when": {"hostname": "raspberry|raspberrypi|^rpi|^pi\\d*(-|$)|pihole|pi-hole|orange-?pi|banana-?pi|rock-?pi|rockpro|odroid|radxa|nanopi|libre-?computer|jetson"}, "label": "Single-board computer"},
    {"id": "host.home-assistant", "category": "server", "weight": 0.95, "when": {"hostname": "home-?assistant|^hassio|^hass(-|$)|^homeassistant"}, "label": "Home Assistant", "icon": "mdi:home-assistant"},
    {"id": "host.server-word", "category": "server", "weight": 0.6, "when": {"hostname": "(^|[-_])(server|srv\\d*|proxmox|pve\\d*|esxi|docker|nuc|homelab|home-?server|сервер|unraid|kube|k8s|node\\d+)([-_]|$)"}},
    {"id": "host.nas", "category": "nas", "weight": 0.85, "when": {"hostname": "(^|[-_])nas([-_]|\\d|$)|diskstation|synology|^ds\\d{3,4}|qnap|^ts-\\d{3}|truenas|freenas|openmediavault|^omv|readynas|mycloud|wdmycloud|хранилище"}},
    {"id": "host.router", "category": "router", "weight": 0.65, "when": {"hostname": "(^|[-_])(router|gateway|gw|openwrt|lede|keenetic|mikrotik|routeros|pfsense|opnsense|fritz|asuswrt|dd-wrt|роутер|маршрутизатор)([-_]|\\d|$)"}},
    {"id": "host.ap", "category": "access-point", "weight": 0.65, "when": {"hostname": "(^|[-_])(ap\\d*|access-?point|mesh|repeater|extender|satellite|deco|eero|orbi|velop|unifi|uap|miwifi|xiaomi-?router|redmi-?router|rd\\d\\d|ax\\d{4}|точка|репитер)([-_]|\\d|$)|_minet_"}}
  ]
}
